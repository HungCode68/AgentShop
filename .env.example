# Chép file này thành .env để chạy local. Trên server, biến môi trường lấy từ
# Jenkinsfile và Jenkins Credentials (xem DEPLOY_GUIDE.md), không dùng file .env.

# ===== Frontend (Vite) =====
# Base URL của API (gateway). Mặc định "/api" = cùng domain với frontend:
#   - production: nginx chuyển /api/ sang gateway
#   - dev: Vite proxy /api sang http://localhost:8090 (xem vite.config.ts)
# Vite chỉ đưa các biến có tiền tố VITE_ vào code trình duyệt, các biến bên dưới không bị lộ.
VITE_API_BASE_URL=/api

# ===== Gateway (cd gateway && npm start; docker compose cũng đọc các biến này) =====
# Cổng gateway lắng nghe
PORT=8090

# Token để gọi API quản trị /api/admin/* (tối thiểu 24 ký tự).
# Tạo bằng: openssl rand -hex 32
ADMIN_TOKEN=

# Khoá mã hoá key agentshop (as_...) và bản sao key ak_ lưu trong DB: 32 byte, dạng hex 64 ký tự hoặc base64.
# Tạo bằng: openssl rand -hex 32
# CẢNH BÁO: không được đổi sau khi đã có dữ liệu, nếu không sẽ không giải mã được các key đã lưu.
ENCRYPTION_KEY=

# Nguồn AI: tài khoản revidapi (một key sk_ dùng chung cho mọi khách; hạn mức từng khách do gateway tự đếm).
# Trên server lấy từ Jenkins Credentials "GATEWAY_REVID_API_KEY". Thiếu biến này gateway sẽ không khởi động.
REVID_API_KEY=
# Cảnh báo trong /admin khi số credit revidapi còn lại dưới mức này
REVID_LOW_CREDITS=300
# Sau bao nhiêu ms chưa có phản hồi thì gửi lại request lên revidapi (0 = tắt, mặc định).
# revidapi bình thường mất 6–30 giây mới trả byte đầu tiên, nên mốc ngắn sẽ gửi đôi request khoẻ và tốn gấp đôi credit.
HEDGE_AFTER_MS=0
# Số request chạy cùng lúc tối đa cho mỗi key ak_ (0 = không giới hạn)
MAX_CONCURRENT_PER_KEY=3

# (Cũ) API agentshop, không còn dùng cho AI
UPSTREAM_BASE_URL=https://api.agentshop247.com/api

# API Host ghi vào script cài nhanh Claude Code (GET /api/setup). Khi chạy local có thể để http://localhost:8090/api/proxy
PUBLIC_API_HOST=https://agentshop.id.vn/api/proxy

# File SQLite (đường dẫn tính từ thư mục gateway/)
DB_PATH=./data/gateway.db

# Tiền tố key cấp cho client
KEY_PREFIX=ak_

# Origin được phép gọi /api/proxy/check-usage từ trình duyệt (phân tách bằng dấu phẩy, * = tất cả)
CORS_ORIGINS=*

# Giới hạn kích thước request body (MB)
MAX_BODY_MB=50
