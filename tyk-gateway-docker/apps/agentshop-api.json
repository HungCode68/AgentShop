{
  "name": "Agentshop Proxy API",
  "api_id": "agentshop-proxy",
  "org_id": "default",
  "definition": {
    "location": "header",
    "key": "version"
  },
  "use_keyless": true,
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default"
      }
    }
  },
  "CORS": {
    "enable": true,
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["*"]
  },
  "proxy": {
    "listen_path": "/api/proxy",
    "target_url": "https://api.agentshop247.com/api/proxy",
    "strip_listen_path": true
  },
  "enable_batch_request_support": false,
  "dont_set_quota_on_ip": true,
  "upstream_connection_timeout": 120
}
