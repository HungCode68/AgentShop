{
  "name": "Agentshop Usage API",
  "api_id": "agentshop-usage",
  "org_id": "default",
  "definition": {
    "location": "header",
    "key": "version"
  },
  "use_keyless": true,
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default"
      }
    }
  },
  "CORS": {
    "enable": true,
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "OPTIONS"],
    "allowed_headers": ["*"]
  },
  "proxy": {
    "listen_path": "/api/proxy/check-usage",
    "target_url": "https://api.agentshop247.com/api/proxy/check-usage",
    "strip_listen_path": true,
    "transport": {
      "ssl_insecure_skip_verify": true
    }
  },
  "upstream_connection_timeout": 30
}
 